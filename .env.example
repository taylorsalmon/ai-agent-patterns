# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Discord — Brian (Pipeline Manager bot)
BRIAN_TOKEN=your_brian_bot_token_here

# Discord — Sarah (Account Manager bot)
SARAH_TOKEN=your_sarah_bot_token_here

# Discord — channel ID where both bots post
DISCORD_CHANNEL_ID=your_channel_id_here

# Firebase Realtime Database (direct access — fallback only)
FIREBASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SECRET=your_firebase_database_secret

# Resolve Studios CRM API (preferred — goes through the app's own endpoint)
RESOLVE_CRM_URL=https://resolve-studios.vercel.app
RESOLVE_CRM_SECRET=your_api_secret
